# Zetaris (Data layer) — SQL via the UI proxy at /api/proxy/sql-editor/sqls/run-query
ZETARIS_BASE_URL=http://localhost:3000
ZETARIS_ORG_ID=
ZETARIS_API_KEY=
ZETARIS_QUERY_LIMIT=1000
# Optional SQL used when querying company threat context (read-only SELECT only)
ZETARIS_THREAT_SQL=

# Meterless (Build / Power layer)
# Local Nightshift OpenAI-compatible hotspot (optional).
# When METERLESS_API_KEY is set, each council agent calls POST /chat/completions
# and may vote only for tools in the defensive arsenal. Unset keeps the local template.
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_API_KEY=
METERLESS_MODEL=meterless/local
# Council / Scout knobs
METERLESS_COUNCIL_ROUNDS=3
METERLESS_TOOLS_PER_ROUND=4
